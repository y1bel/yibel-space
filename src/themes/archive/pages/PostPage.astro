---
import type { PostPageData } from "@core/theme";
import ArchiveShell from "../components/ArchiveShell.astro";
import ArchiveIndex from "../components/ArchiveIndex.astro";
import CaseHeader from "../components/CaseHeader.astro";
import DocumentViewer from "../components/DocumentViewer.astro";
import FileMetadataPanel from "../components/FileMetadataPanel.astro";
import ClassificationStamp from "../components/ClassificationStamp.astro";
import { getArchivePostMetadata } from "../metadata";

interface Props { data: PostPageData; }
const { data } = Astro.props;
const { metadata, body: Body } = data.post;
const archiveMetadata = getArchivePostMetadata(metadata);
const formatDate = (date: Date) => new Intl.DateTimeFormat("en-CA", { year: "numeric", month: "long", day: "2-digit" }).format(date).toUpperCase();
const classification = archiveMetadata.classification ?? "public";
const fileNumber = archiveMetadata.recordId ?? metadata.id.toUpperCase();
const documentType = archiveMetadata.documentType ?? "record";
const recordStatus = archiveMetadata.recordStatus ?? "released";
const dateOfRecord = archiveMetadata.receivedAt ?? formatDate(metadata.publishedAt);
const indexTerms = archiveMetadata.indexTerms ?? metadata.tags;
const researchNotes = archiveMetadata.researchNotes ?? metadata.description ?? "No research notes are available for this record.";
const redactions = archiveMetadata.redactions ?? [];
---

<ArchiveShell section="RESEARCH & RECORDS" title={`CASE FILE / ${fileNumber}`} classification={classification} workspace>
  <section class="a1-workspace" aria-label="Archive workspace">
    <ArchiveIndex currentFile={fileNumber} classification={classification.toUpperCase()} />
    <div class="a1-paged-document" data-a1-paged-document data-a1-record-id={fileNumber} data-a1-document-type={documentType} data-a1-classification={classification} data-a1-redactions={JSON.stringify(redactions)}>
      <div class="a1-paged-document__measure" aria-hidden="true">
        <DocumentViewer fileNumber={fileNumber}>
          <article class="a1-case-file a1-case-file--measure" aria-labelledby="record-title">
            <CaseHeader post={metadata} documentType={documentType} recordId={fileNumber} />
            <section class="a1-case-file__body" aria-label="Archive content">
              <div class="a1-case-file__content" data-a1-document-content><Body /></div>
            </section>
            <footer class="a1-case-file__footer"><span>END OF RECORD</span><span>01 / 01</span></footer>
            <div class="a1-stamp-overlay" aria-hidden="true">
              <ClassificationStamp level={classification} />
            </div>
          </article>
        </DocumentViewer>
      </div>

      <div class="a1-paged-document__viewport" data-a1-viewport>
        <div class="a1-paged-document__pages" data-a1-pages></div>
      </div>

      <div class="a1-paged-document__nav" data-a1-nav hidden>
        <button class="a1-paged-document__btn" data-a1-prev aria-label="Previous page">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          <span>PREV</span>
        </button>
        <div class="a1-paged-document__indicator" data-a1-indicator>01 / 01</div>
        <button class="a1-paged-document__btn" data-a1-next aria-label="Next page">
          <span>NEXT</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>
    <FileMetadataPanel items={[
      { label: "FILE NUMBER", value: fileNumber },
      { label: "DOCUMENT TYPE", value: documentType.toUpperCase() },
      { label: "CLASSIFICATION", value: classification.toUpperCase() },
      { label: "RECORD STATUS", value: recordStatus.toUpperCase() },
      { label: "DATE OF RECORD", value: dateOfRecord }
    ]} tags={indexTerms} researchNotes={researchNotes} />
  </section>
</ArchiveShell>

<script>
  const documentContent = document.querySelector("[data-a1-document-content]");
  const redactionSource = document.querySelector("[data-a1-paged-document]")?.getAttribute("data-a1-redactions");
  const redactions = redactionSource ? JSON.parse(redactionSource) : [];

  if (documentContent && Array.isArray(redactions)) {
    for (const redaction of redactions) {
      if (
        !redaction ||
        typeof redaction.text !== "string" ||
        !["person", "location", "date", "identifier"].includes(redaction.kind)
      ) continue;

      const walker = document.createTreeWalker(documentContent, NodeFilter.SHOW_TEXT);
      let node;
      while ((node = walker.nextNode())) {
        const source = node.nodeValue || "";
        const start = source.indexOf(redaction.text);
        if (start < 0) continue;

        const before = source.slice(0, start);
        const match = source.slice(start, start + redaction.text.length);
        const after = source.slice(start + redaction.text.length);
        const wrapper = document.createElement("span");
        const mask = document.createElement("span");
        wrapper.className = "a1-inline-redaction";
        wrapper.dataset.a1RedactionKind = redaction.kind;
        wrapper.tabIndex = 0;
        wrapper.setAttribute("role", "button");
        wrapper.setAttribute("aria-pressed", "false");
        wrapper.setAttribute("aria-label", "Redacted text. Hover, focus, or click to reveal.");
        wrapper.textContent = match;
        mask.className = "a1-inline-redaction__mask";
        mask.setAttribute("aria-hidden", "true");
        wrapper.appendChild(mask);
        const toggleReveal = () => {
          const isRevealed = wrapper.classList.toggle("is-revealed");
          wrapper.setAttribute("aria-pressed", String(isRevealed));
        };
        wrapper.addEventListener("click", toggleReveal);
        wrapper.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            toggleReveal();
          }
        });

        const fragment = document.createDocumentFragment();
        fragment.append(before, wrapper, after);
        node.parentNode?.replaceChild(fragment, node);
        break;
      }
    }
  }
</script>

<script>
// @ts-nocheck
(function() {
  const root = document.querySelector("[data-a1-paged-document]");
  if (!root) return;

  const recordId = root.getAttribute("data-a1-record-id") || "";
  const documentType = root.getAttribute("data-a1-document-type") || "RECORD";

  const isMobile = window.matchMedia("(max-width: 720px)").matches;

  if (isMobile) {
    const measureWrap = root.querySelector(".a1-paged-document__measure");
    if (measureWrap) {
      measureWrap.style.display = "";
      measureWrap.removeAttribute("aria-hidden");
    }
    return;
  }

  function isNonSplittable(block) {
    const tag = block.tagName.toLowerCase();
    if (tag === "pre" || tag === "code" || tag === "img" || tag === "table") return true;
    if (block.querySelector("pre, code, img, table")) return true;
    return false;
  }

  function isTextBlock(block) {
    const tag = block.tagName.toLowerCase();
    return tag === "p" || tag === "li" || tag === "blockquote";
  }

  function isListBlock(block) {
    const tag = block.tagName.toLowerCase();
    return tag === "ol" || tag === "ul";
  }

  function splitListBlock(block, availableHeight, tempContainer) {
    const items = Array.from(block.children);
    if (items.length <= 1) return null;

    let fittingItems = [];
    let remainingItems = [];

    const testBlock = block.cloneNode(true);
    testBlock.innerHTML = "";
    tempContainer.appendChild(testBlock);

    for (let i = 0; i < items.length; i++) {
      testBlock.appendChild(items[i].cloneNode(true));
      const h = testBlock.getBoundingClientRect().height;
      if (h <= availableHeight) {
        fittingItems.push(items[i]);
      } else {
        remainingItems = items.slice(i);
        break;
      }
    }

    tempContainer.removeChild(testBlock);

    if (fittingItems.length === 0 || remainingItems.length === 0) return null;

    const firstClone = block.cloneNode(true);
    firstClone.innerHTML = "";
    fittingItems.forEach(item => firstClone.appendChild(item.cloneNode(true)));

    const secondClone = block.cloneNode(true);
    secondClone.innerHTML = "";
    remainingItems.forEach(item => secondClone.appendChild(item.cloneNode(true)));

    return [firstClone, secondClone];
  }

  function splitTextBlockAtSentence(block, availableHeight, measureContent) {
    const text = block.textContent || "";
    const sentences = text.split(/(?<=[。！？.!?;；])\s+/);
    if (sentences.length <= 1) return null;

    let fittingSentences = [];
    let remainingSentences = [...sentences];

    const testBlock = block.cloneNode(true);
    testBlock.textContent = "";
    measureContent.appendChild(testBlock);

    for (let i = 0; i < sentences.length; i++) {
      const testSentences = [...fittingSentences, sentences[i]];
      testBlock.textContent = testSentences.join(" ");
      const h = testBlock.getBoundingClientRect().height;
      if (h <= availableHeight) {
        fittingSentences.push(sentences[i]);
        remainingSentences.shift();
      } else {
        break;
      }
    }

    measureContent.removeChild(testBlock);

    if (fittingSentences.length === 0) return null;
    if (remainingSentences.length === 0) return null;

    const firstClone = block.cloneNode(true);
    firstClone.textContent = fittingSentences.join(" ");

    const secondClone = block.cloneNode(true);
    secondClone.textContent = remainingSentences.join(" ");

    return [firstClone, secondClone];
  }

  function runPaging() {
    const measureArticle = root.querySelector(".a1-case-file--measure");
    const measureBody = root.querySelector(".a1-case-file--measure .a1-case-file__body");
    const measureContent = root.querySelector("[data-a1-document-content]");
    const measureHeader = root.querySelector(".a1-case-file--measure .a1-case-header");

    if (!measureArticle || !measureBody || !measureContent) return;

    const bodyRect = measureBody.getBoundingClientRect();
    const bodyComputed = getComputedStyle(measureBody);
    const bodyPaddingTop = parseFloat(bodyComputed.paddingTop) || 0;
    const bodyPaddingBottom = parseFloat(bodyComputed.paddingBottom) || 0;

    if (bodyRect.height <= 0) {
      requestAnimationFrame(runPaging);
      return;
    }

    const SAFETY_MARGIN = 32;
    const availableContentHeight = bodyRect.height - bodyPaddingTop - bodyPaddingBottom - SAFETY_MARGIN;

    const blocks = Array.from(measureContent.children);
    if (blocks.length === 0) return;

    const tempPage = document.createElement("div");
    tempPage.style.cssText = "position:absolute;visibility:hidden;left:-9999px;width:700px;";
    const tempContent = document.createElement("div");
    tempContent.className = "a1-case-file__content";
    tempPage.appendChild(tempContent);
    document.body.appendChild(tempPage);

    const pages = [];
    let currentPageItems = [];
    let isFirstPage = true;

    for (let i = 0; i < blocks.length; i++) {
      const block = blocks[i];
      const isText = isTextBlock(block);
      const isList = isListBlock(block);
      const nonSplittable = isNonSplittable(block);
      const canSplit = !nonSplittable && (isText || isList);

      tempContent.appendChild(block.cloneNode(true));
      const testHeight = tempContent.getBoundingClientRect().height;

      if (testHeight <= availableContentHeight || currentPageItems.length === 0) {
        currentPageItems.push({ type: "block", index: i });

        if (testHeight > availableContentHeight && canSplit) {
          tempContent.removeChild(tempContent.lastChild);
          const remainingHeight = availableContentHeight - tempContent.getBoundingClientRect().height;
          if (remainingHeight > 40) {
            let splitResult = null;
            if (isList) {
              splitResult = splitListBlock(block, remainingHeight, tempContent);
            } else {
              splitResult = splitTextBlockAtSentence(block, remainingHeight, tempContent);
            }
            if (splitResult) {
              currentPageItems[currentPageItems.length - 1] = {
                type: "split-first",
                index: i,
                customElement: splitResult[0]
              };
              pages.push({ items: currentPageItems, isFirstPage: isFirstPage });

              tempContent.innerHTML = "";
              tempContent.appendChild(splitResult[1].cloneNode(true));
              currentPageItems = [{
                type: "split-second",
                index: i,
                customElement: splitResult[1]
              }];
              isFirstPage = false;
              continue;
            }
          }
          tempContent.appendChild(block.cloneNode(true));
        }
      } else {
        tempContent.removeChild(tempContent.lastChild);
        pages.push({ items: currentPageItems, isFirstPage: isFirstPage });
        currentPageItems = [];
        tempContent.innerHTML = "";

        tempContent.appendChild(block.cloneNode(true));
        const blockHeight = tempContent.getBoundingClientRect().height;

        if (blockHeight > availableContentHeight && canSplit) {
          tempContent.removeChild(tempContent.lastChild);
          const splitResult = isList
            ? splitListBlock(block, availableContentHeight, tempContent)
            : splitTextBlockAtSentence(block, availableContentHeight, tempContent);
          if (splitResult) {
            currentPageItems.push({
              type: "split-first",
              index: i,
              customElement: splitResult[0]
            });
            pages.push({ items: currentPageItems, isFirstPage: false });

            tempContent.innerHTML = "";
            tempContent.appendChild(splitResult[1].cloneNode(true));
            currentPageItems = [{
              type: "split-second",
              index: i,
              customElement: splitResult[1]
            }];
            isFirstPage = false;
            continue;
          }
        }

        currentPageItems = [{ type: "block", index: i }];
        isFirstPage = false;
      }
    }
    if (currentPageItems.length > 0) {
      pages.push({ items: currentPageItems, isFirstPage: isFirstPage });
    }

    document.body.removeChild(tempPage);

    const totalPages = pages.length;

    const viewport = root.querySelector("[data-a1-viewport]");
    const pagesContainer = root.querySelector("[data-a1-pages]");

    if (!viewport || !pagesContainer) return;

    const nav = root.querySelector("[data-a1-nav]");
    const indicator = root.querySelector("[data-a1-indicator]");
    const prevBtn = root.querySelector("[data-a1-prev]");
    const nextBtn = root.querySelector("[data-a1-next]");

    pagesContainer.innerHTML = "";
    const pageElements = [];

    for (let pageIdx = 0; pageIdx < totalPages; pageIdx++) {
      const pageData = pages[pageIdx];
      const article = document.createElement("article");
      article.className = "a1-case-file a1-case-file--page";
      article.setAttribute("aria-labelledby", "record-title");
      article.dataset.pageIndex = String(pageIdx);
      article.dataset.pageCount = String(totalPages);

      if (pageData.isFirstPage) {
        const headerClone = measureHeader.cloneNode(true);
        article.appendChild(headerClone);
      } else {
        const header = document.createElement("header");
        header.className = "a1-case-header a1-case-header--continued";
        const top = document.createElement("div");
        top.className = "a1-case-header__top";
        top.innerHTML = `<span>${documentType.toUpperCase()}</span><span>${recordId} · CONTINUED</span>`;
        header.appendChild(top);
        article.appendChild(header);
      }

      const body = document.createElement("section");
      body.className = "a1-case-file__body";
      body.setAttribute("aria-label", "Archive content");

      const content = document.createElement("div");
      content.className = "a1-case-file__content";

      for (const item of pageData.items) {
        if (item.type === "block") {
          content.appendChild(blocks[item.index].cloneNode(true));
        } else if (item.type === "split-first" || item.type === "split-second") {
          content.appendChild(item.customElement.cloneNode(true));
        }
      }

      body.appendChild(content);
      article.appendChild(body);

      const footer = document.createElement("footer");
      footer.className = "a1-case-file__footer";
      const endLabel = pageIdx === totalPages - 1 ? "END OF RECORD" : "CONTINUED";
      const pageLabel = `PAGE ${String(pageIdx + 1).padStart(2, "0")} OF ${String(totalPages).padStart(2, "0")}`;
      footer.innerHTML = `<span>${endLabel}</span><span>${pageLabel}</span>`;
      article.appendChild(footer);

      if (pageData.isFirstPage) {
        const stamp = document.createElement("div");
        stamp.className = "a1-stamp-overlay";
        stamp.setAttribute("aria-hidden", "true");
        stamp.innerHTML = measureArticle.querySelector(".a1-stamp-overlay")?.innerHTML || "";
        article.appendChild(stamp);
      }

      pagesContainer.appendChild(article);
      pageElements.push(article);
    }

    if (indicator) indicator.innerHTML = "";

    const indicatorLabels = pageElements.map((_, i) => {
      const label = document.createElement("button");
      label.className = "a1-paged-document__dot";
      label.setAttribute("aria-label", `Page ${i + 1}`);
      label.addEventListener("click", () => goToPage(i));
      indicator?.appendChild(label);
      return label;
    });

    let currentPage = 0;

    function update() {
      pageElements.forEach((el, i) => {
        el.classList.toggle("is-active", i === currentPage);
        el.classList.toggle("is-inactive", i !== currentPage);
      });
      indicatorLabels.forEach((el, i) => {
        el.classList.toggle("is-active", i === currentPage);
      });
      if (indicator) {
        indicator.querySelectorAll(".a1-paged-document__indicator-text").forEach(el => el.remove());
        const textLabel = document.createElement("span");
        textLabel.className = "a1-paged-document__indicator-text";
        textLabel.textContent = `${String(currentPage + 1).padStart(2, "0")} / ${String(totalPages).padStart(2, "0")}`;
        indicator.insertBefore(textLabel, indicator.firstChild);
      }
      if (prevBtn) prevBtn.disabled = currentPage === 0;
      if (nextBtn) nextBtn.disabled = currentPage === totalPages - 1;
    }

    function goToPage(index) {
      currentPage = Math.max(0, Math.min(totalPages - 1, index));
      update();
    }

    if (prevBtn) {
      prevBtn.onclick = () => goToPage(currentPage - 1);
    }
    if (nextBtn) {
      nextBtn.onclick = () => goToPage(currentPage + 1);
    }

    const keyHandler = (e) => {
      if (e.key === "ArrowLeft") goToPage(currentPage - 1);
      else if (e.key === "ArrowRight") goToPage(currentPage + 1);
    };
    document.addEventListener("keydown", keyHandler);

    update();
    if (nav) nav.hidden = false;

    const measureWrap = root.querySelector(".a1-paged-document__measure");
    if (measureWrap) {
      measureWrap.setAttribute("data-a1-ready", "true");
    }
  }

  requestAnimationFrame(runPaging);
})();
</script>
