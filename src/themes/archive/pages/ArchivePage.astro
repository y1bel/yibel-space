---
import type { ArchivePageData } from "@core/theme";
import { getMessages } from "@core/i18n";
import { routes } from "@core/routing";
import SystemShell from "../components/SystemShell.astro";
import ModuleHeading from "../components/ModuleHeading.astro";
import SectionTabs from "../components/SectionTabs.astro";
import EmptyRecord from "../components/EmptyRecord.astro";
interface Props { data: ArchivePageData; }
const { data } = Astro.props;
const copy = getMessages();
const tabs = [{ id: "all", label: "allLogs" }, { id: "research", label: "research" }, { id: "fragment", label: "fragments" }] as const;
const kind = (post: (typeof data.posts)[number]) => post.category === "fragment" ? "fragment" : "research";
---
<SystemShell workspace active="logs" code="L-002">
  <section class="yt-section">
    <ModuleHeading title="logs" summary="logsSummary" code="L-002" count={data.posts.length} />
    <SectionTabs id="logs" tabs={[...tabs]}><a href={routes.timeline} data-yt-copy="timeline">{copy.timeline}</a></SectionTabs>
    {tabs.map((tab, index) => {
      const posts = data.posts.filter((post) => tab.id === "all" || kind(post) === tab.id);
      return <div class="yt-tab-panel" id={`logs-panel-${tab.id}`} role="tabpanel" aria-labelledby={`logs-tab-${tab.id}`} tabindex="0" hidden={index !== 0}>
        {posts.length ? <ol class="yt-ledger">{posts.map((post) => <li class="yt-ledger__row"><a class="yt-ledger__link" href={routes.post(post.slug)}><time datetime={post.publishedAt.toISOString()}>{post.publishedAt.toISOString().slice(0, 10)}</time><div><h2>{post.title}</h2>{post.description && <p>{post.description}</p>}{post.tags.length > 0 && <span class="yt-ledger__tag">{post.tags.join(" / ")}</span>}</div><span class="yt-ledger__type" data-yt-copy={kind(post) === "fragment" ? "fragments" : "research"}>{kind(post) === "fragment" ? copy.fragments : copy.research}</span></a></li>)}</ol> : <EmptyRecord title="noLogs" description="logsCopy" />}
      </div>;
    })}
  </section>
</SystemShell>
