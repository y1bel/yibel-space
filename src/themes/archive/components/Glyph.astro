---
interface Props {
  name: "archive" | "arrow" | "signal" | "record" | "terminal";
  size?: "small" | "medium";
}

const { name, size = "small" } = Astro.props;
---

<span class:list={["a1-glyph", `a1-glyph--${size}`]} aria-hidden="true">
  {
    name === "archive" && <svg viewBox="0 0 24 24" fill="none"><path d="M4 7.5h16M6 7.5V19h12V7.5M8.5 4.5h7l1 3h-9l1-3ZM9.5 12h5" /></svg>
  }
  {
    name === "arrow" && <svg viewBox="0 0 24 24" fill="none"><path d="M4 12h14M13 6l6 6-6 6" /></svg>
  }
  {
    name === "signal" && <svg viewBox="0 0 24 24" fill="none"><path d="M5 19V14M10 19V10M15 19V6M20 19V3" /></svg>
  }
  {
    name === "record" && <svg viewBox="0 0 24 24" fill="none"><path d="M6 3.5h9l3 3V20.5H6zM14.5 3.5v4h4M9 12h6M9 16h6" /></svg>
  }
  {
    name === "terminal" && <svg viewBox="0 0 24 24" fill="none"><path d="m5 7 5 5-5 5M13 17h6" /></svg>
  }
</span>
