---
import { getMessages, localeMessages } from "@core/i18n";
import { systemNavigation } from "@core/navigation";

const copy = getMessages();
const hrefFor = Object.fromEntries(systemNavigation.map((item) => [item.id, item.href])) as Record<string, string>;
const worldMessages = {
  "en-US": {
    archiveWorld: localeMessages["en-US"].archiveWorld,
    worldOpenHint: localeMessages["en-US"].worldOpenHint,
  },
  "zh-CN": {
    archiveWorld: localeMessages["zh-CN"].archiveWorld,
    worldOpenHint: localeMessages["zh-CN"].worldOpenHint,
  },
};
---

<style is:global>@import "../styles/home-world.css";</style>

<section class="yt-world3d" data-yt-world3d>
  <canvas class="yt-world3d__canvas" data-yt-world-canvas aria-label="Yibel Space archive world"></canvas>

  <div class="yt-world3d__brand" aria-hidden="true">
    <i></i><span>YIBEL SPACE</span><b></b>
  </div>

  <div class="yt-world3d__label yt-world3d__label--personnel" data-yt-world-label="personnel">
    <i></i><strong data-yt-copy="personnel">{copy.personnel}</strong>
  </div>
  <div class="yt-world3d__label yt-world3d__label--collections" data-yt-world-label="collections">
    <i></i><strong data-yt-copy="collections">{copy.collections}</strong>
  </div>
  <div class="yt-world3d__label yt-world3d__label--logs" data-yt-world-label="logs">
    <i></i><strong data-yt-copy="logs">{copy.logs}</strong>
  </div>
  <div class="yt-world3d__label yt-world3d__label--creations" data-yt-world-label="creations">
    <i></i><strong data-yt-copy="creations">{copy.creations}</strong>
  </div>
  <div class="yt-world3d__label yt-world3d__label--sites" data-yt-world-label="sites">
    <i></i><strong data-yt-copy="sites">{copy.sites}</strong>
  </div>

  <div class="yt-world3d__reticle" data-yt-world-reticle aria-hidden="true">
    <span></span><span></span><span></span><span></span><i></i>
  </div>

  <div class="yt-world3d__context" data-yt-world-context>
    <small data-yt-copy="archiveWorld">{copy.archiveWorld}</small>
    <strong data-yt-copy="logs">{copy.logs}</strong>
    <span data-yt-copy="worldOpenHint">{copy.worldOpenHint}</span>
  </div>

  <div class="yt-world3d__tab"><kbd>TAB</kbd><span data-yt-copy="openMenu">{copy.openMenu}</span></div>

  <div hidden data-yt-world-routes
    data-personnel={hrefFor.personnel}
    data-logs={hrefFor.logs}
    data-creations={hrefFor.creations}
    data-collections={hrefFor.collections}
    data-sites={hrefFor.sites}
  ></div>
</section>

<script>
  import "../interactions/home-world";
</script>

<script is:inline define:vars={{ worldMessages }}>
  const worldContext = document.querySelector("[data-yt-world-context]");
  const syncWorldCopy = () => {
    if (!worldContext) return;
    const locale = document.documentElement.lang === "en-US" ? "en-US" : "zh-CN";
    const dictionary = worldMessages[locale];
    const eyebrow = worldContext.querySelector("small");
    const title = worldContext.querySelector("strong");
    const hint = worldContext.querySelector("span");
    const activeWorldLabel = document.querySelector("[data-yt-world-label].is-active strong");
    if (eyebrow && eyebrow.textContent !== dictionary.archiveWorld) eyebrow.textContent = dictionary.archiveWorld;
    if (title && activeWorldLabel && title.textContent !== activeWorldLabel.textContent) title.textContent = activeWorldLabel.textContent;
    if (hint && hint.textContent !== dictionary.worldOpenHint) hint.textContent = dictionary.worldOpenHint;
  };
  if (worldContext) {
    const contextObserver = new MutationObserver(syncWorldCopy);
    contextObserver.observe(worldContext, { childList: true, subtree: true });
    const localeObserver = new MutationObserver(syncWorldCopy);
    localeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["lang"] });
    syncWorldCopy();
  }
</script>
