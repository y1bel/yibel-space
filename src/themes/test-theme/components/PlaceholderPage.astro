---
import type { PageData } from "@core/theme";

interface Props {
  data: PageData;
}

const { data } = Astro.props;
const Body = data.kind === "post" ? data.post.body : undefined;
---

<main>
  <h1>Test theme / {data.kind}</h1>
  <p>Contract-validation placeholder. No visual system has been implemented.</p>
  {data.kind === "post" && <p>{data.post.metadata.title}</p>}
  {Body && <Body />}
</main>
