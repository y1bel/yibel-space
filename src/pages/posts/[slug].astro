---
import { getPosts, getRenderedPostBySlug } from "@core/content";
import { getActiveTheme, type PostPageData } from "@core/theme";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const theme = getActiveTheme();
const Page = theme.pages.post;
const post = await getRenderedPostBySlug(Astro.params.slug ?? "");
if (!post) {
  throw new Error(`Post not found: ${Astro.params.slug}`);
}
const data: PostPageData = { kind: "post", post };
---

<Page data={data} />
