---
import { getProjectBySlug, getProjects } from "@core/content";
import { getActiveTheme, type ProjectPageData } from "@core/theme";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.slug } }));
}

const theme = getActiveTheme();
const Page = theme.pages.project;
const project = await getProjectBySlug(Astro.params.slug ?? "");
if (!project) {
  throw new Error(`Project not found: ${Astro.params.slug}`);
}
const data: ProjectPageData = { kind: "project", project };
---

<Page data={data} />
