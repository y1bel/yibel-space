---
import { getPosts, getProjects, getTimeline } from "@core/content";
import { getActiveTheme } from "@core/theme";

const theme = getActiveTheme();
const Page = theme.pages.home;
const [posts, projects, timeline] = await Promise.all([getPosts(), getProjects(), getTimeline()]);
const dataSummary = `posts: ${posts.length}, projects: ${projects.length}, timeline: ${timeline.length}`;
---

<Page page="Home" dataSummary={dataSummary} />
